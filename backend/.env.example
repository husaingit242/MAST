APP_ENV=development
DATABASE_URL=postgresql+psycopg://mast:mast-dev-only@localhost:5432/mast
JWT_SECRET_KEY=replace-with-a-random-secret-before-any-shared-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIRECTORY=./var/uploads
TEMP_UPLOAD_DIRECTORY=./var/tmp/uploads
ALLOWED_UPLOAD_EXTENSIONS=apk,aab,ipa,zip
REPORT_DIRECTORY=./var/reports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
